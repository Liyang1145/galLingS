{
  "name": "haifeng-pudding-rebuild",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "content:build": "node tools/content/build.ts",
    "story:dev": "node tools/dev/story.ts",
    "game:dev": "vite --config tools/dev/vite.config.ts",
    "editor:dev": "vite --config tools/editor/vite.config.ts",
    "game:build": "node tools/game/build.ts",
    "windows:prepare": "node tools/game/windows.ts",
    "android:prepare": "node tools/game/android.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
