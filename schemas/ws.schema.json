{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallings.dev/schemas/ws.schema.json",
  "title": "galLingS WebSocket 协议",
  "description": "PLAN §14.1。所有消息都是一个 JSON 对象，用 type 区分。四个端点：/ws（引擎会话，server/session.py）、/ws/replay 与 /ws?replay=（录制回放演示模式，server/replay.py ReplayPlayer）、/ws/soul（灵枢外部端口 vn-soul/1，server/soul.py）、/ws/post_ending（结局后聊天 galagent/1，plugins/builtin/galagent/loop.py）。$defs 下 <端点>_c2s / <端点>_s2c 是各端点每个方向的全部消息。以实际代码为准；说明见 docs/protocol.md，契约测试 tests/contract/test_schemas.py。",
  "anyOf": [
    {"$ref": "#/$defs/main_c2s"}, {"$ref": "#/$defs/main_s2c"},
    {"$ref": "#/$defs/replay_c2s"}, {"$ref": "#/$defs/replay_s2c"},
    {"$ref": "#/$defs/soul_c2s"}, {"$ref": "#/$defs/soul_s2c"},
    {"$ref": "#/$defs/post_ending_c2s"}, {"$ref": "#/$defs/post_ending_s2c"}
  ],
  "$defs": {
    "msg_id": {"type": ["integer", "string", "null"], "description": "请求 ID，原样带回"},
    "slot": {"type": ["string", "integer"], "description": "服务端按字符串处理（缺省 \"1\"）"},
    "render_op": {"$ref": "op.schema.json#/$defs/render_op"},
    "state_op": {"$ref": "op.schema.json#/$defs/op_STATE"},
    "choice_op": {"allOf": [{"$ref": "op.schema.json#/$defs/render_op"}, {"properties": {"op": {"const": "CHOICE"}}}]},

    "c_start": {"type": "object", "additionalProperties": false, "required": ["type", "line_id"],
                "description": "从某一章开头开局（VN Studio 作品的章节入口句 ID）；只能是第一个动作",
                "properties": {"type": {"const": "start"}, "line_id": {"type": "string"}}},
    "c_advance": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "advance"}}},
    "c_choose": {"type": "object", "additionalProperties": false, "required": ["type", "option_id"],
                 "properties": {"type": {"const": "choose"}, "option_id": {"type": "string", "minLength": 1}}},
    "c_input": {"type": "object", "additionalProperties": false, "required": ["type", "text"],
                "description": "AI 模式下在选项点打字（服务端截到 200 字）",
                "properties": {"type": {"const": "input"}, "text": {"type": "string"}}},
    "c_mode": {"type": "object", "additionalProperties": false, "required": ["type", "mode"],
               "properties": {"type": {"const": "mode"}, "mode": {"enum": ["choice", "ai"]}}},
    "c_snapshot": {"type": "object", "additionalProperties": false, "required": ["type"],
                   "description": "要一份可带走的引擎快照（播放器自己存档用；不改状态、不记事件）",
                   "properties": {"type": {"const": "snapshot"}}},
    "c_restore": {"type": "object", "additionalProperties": false, "required": ["type", "save"],
                  "description": "新会话从播放器存档里的引擎快照接着跑（连接时带 ?restore=1，服务端不自己开局）",
                  "properties": {"type": {"const": "restore"}, "save": {"$ref": "#/$defs/save_blob"}}},
    "c_save": {"type": "object", "additionalProperties": false, "required": ["type"],
               "properties": {"type": {"const": "save"}, "slot": {"$ref": "#/$defs/slot"}}},
    "c_load": {"type": "object", "additionalProperties": false, "required": ["type"],
               "properties": {"type": {"const": "load"}, "slot": {"$ref": "#/$defs/slot"}}},
    "c_seek": {"type": "object", "additionalProperties": false, "required": ["type", "seq"],
               "description": "调试时间轴拖动：回放到 seq 看那一刻（只看，不改进度）",
               "properties": {"type": {"const": "seek"}, "seq": {"type": "integer", "minimum": 0}}},
    "c_diary": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "diary"}}},

    "main_c2s": {
      "title": "/ws 客户端 → 服务端",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["start", "advance", "choose", "input", "mode", "snapshot", "restore", "save", "load", "seek", "diary"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "start"}}}, "then": {"$ref": "#/$defs/c_start"}},
        {"if": {"properties": {"type": {"const": "advance"}}}, "then": {"$ref": "#/$defs/c_advance"}},
        {"if": {"properties": {"type": {"const": "choose"}}}, "then": {"$ref": "#/$defs/c_choose"}},
        {"if": {"properties": {"type": {"const": "input"}}}, "then": {"$ref": "#/$defs/c_input"}},
        {"if": {"properties": {"type": {"const": "mode"}}}, "then": {"$ref": "#/$defs/c_mode"}},
        {"if": {"properties": {"type": {"const": "snapshot"}}}, "then": {"$ref": "#/$defs/c_snapshot"}},
        {"if": {"properties": {"type": {"const": "restore"}}}, "then": {"$ref": "#/$defs/c_restore"}},
        {"if": {"properties": {"type": {"const": "save"}}}, "then": {"$ref": "#/$defs/c_save"}},
        {"if": {"properties": {"type": {"const": "load"}}}, "then": {"$ref": "#/$defs/c_load"}},
        {"if": {"properties": {"type": {"const": "seek"}}}, "then": {"$ref": "#/$defs/c_seek"}},
        {"if": {"properties": {"type": {"const": "diary"}}}, "then": {"$ref": "#/$defs/c_diary"}}
      ]
    },

    "save_blob": {
      "type": "object", "additionalProperties": false, "required": ["snapshot", "content_hash", "seq", "recent", "choice_op"],
      "properties": {
        "snapshot": {"type": "string", "description": "Engine::snapshot() 的 JSON 字符串（结构见 event.schema.json#/$defs/engine_snapshot）"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "seq": {"type": "integer", "minimum": 0},
        "recent": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
        "choice_op": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/choice_op"}]}
      }
    },
    "card_brief": {"type": "object", "additionalProperties": false, "required": ["id", "name"],
                   "properties": {"id": {"type": ["string", "null"]}, "name": {"type": ["string", "null"]}}},
    "replay_info": {"type": "object", "additionalProperties": false, "required": ["id", "steps", "at", "speed", "paused", "recorded_screen"],
                    "properties": {"id": {"type": "string"}, "steps": {"type": "integer", "minimum": 0}, "at": {"type": "integer", "minimum": 0},
                                   "speed": {"type": "number", "exclusiveMinimum": 0}, "paused": {"type": "boolean"},
                                   "recorded_screen": {"type": "boolean", "description": "日志里有 sent 行；false = 旧日志，画面按事件重建"}}},

    "s_hello": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session", "card", "mode", "llm", "memory", "chapter", "seed", "header"],
      "description": "连接后第一条：会话信息 + 日志头（去掉整张卡）。重播时 session 为 replay-<日志id>，多一个 replay",
      "properties": {
        "type": {"const": "hello"}, "session": {"type": "string", "minLength": 1}, "card": {"$ref": "#/$defs/card_brief"},
        "mode": {"enum": ["choice", "ai"]}, "llm": {"type": "boolean"}, "memory": {"type": "boolean"},
        "chapter": {"type": "object", "additionalProperties": false, "required": ["id", "title"],
                    "properties": {"id": {"type": "string"}, "title": {"type": "string"}}},
        "seed": {"type": ["integer", "null"]},
        "header": {"allOf": [{"$ref": "event.schema.json#/$defs/header_fields"}, {"not": {"required": ["card"]}}]},
        "replay": {"$ref": "#/$defs/replay_info"}
      }
    },
    "s_ops": {"type": "object", "additionalProperties": false, "required": ["type", "ops"],
              "description": "一批渲染指令（引擎 step 的 ops，过了锁定台词校验与演绎层），末尾通常是 STATE",
              "properties": {"type": {"const": "ops"}, "ops": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/render_op"}}}},
    "timeline_out": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "description": "这一步引擎吐出的指令摘要（最多 12 条）",
      "properties": {"op": {"enum": ["SAY", "CHOICE", "SCENE", "BGM", "END", "TAIL", "INPUT"]},
                     "speaker": {"type": ["string", "null"]}, "text": {"type": "string", "maxLength": 60},
                     "src": {"type": ["string", "null"]}, "origin": {"type": ["string", "null"]},
                     "id": {"type": ["string", "null"]}, "bg": {"type": "string"}, "track": {"type": ["string", "null"]},
                     "ending": {"type": ["string", "null"]}, "ending_id": {"type": ["string", "null"]}, "kind": {"type": "string"}, "n": {"type": "integer", "minimum": 0}}
    },
    "timeline_row": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "kind", "source", "payload", "verdicts", "state_hash", "wall_ms", "out", "state"],
      "description": "事件日志的一行 + 指令摘要 + 状态（只给调试时间轴；load 的 payload 去掉了快照）",
      "properties": {
        "seq": {"type": "integer", "minimum": 1}, "kind": {"$ref": "event.schema.json#/$defs/kind"},
        "source": {"$ref": "event.schema.json#/$defs/source"}, "payload": {"type": "object"},
        "verdicts": {"type": "array", "items": {"$ref": "event.schema.json#/$defs/verdict"}},
        "state_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "wall_ms": {"type": "integer", "minimum": 0},
        "display": {"type": "object"},
        "option_text": {"type": "string", "description": "choice 行：所选选项原文"},
        "out": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/timeline_out"}},
        "state": {"type": "object", "additionalProperties": false,
                  "required": ["affection", "tails", "lineage", "turn", "wait", "mode", "vars"],
                  "properties": {"affection": {"type": "integer"}, "tails": {"type": "integer", "minimum": 0},
                                 "lineage": {"type": "string"}, "turn": {"type": "integer", "minimum": 0},
                                 "wait": {"enum": ["ready", "say", "choice", "end"]}, "mode": {"enum": ["choice", "ai"]},
                                 "vars": {"type": "object", "additionalProperties": {"type": "integer"}}}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "load"}}},
         "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["slot", "new_lineage"],
                                             "properties": {"slot": {"type": "string"}, "new_lineage": {"type": "string"}}}}},
         "else": {"$ref": "event.schema.json#/$defs/payload_by_kind"}}
      ]
    },
    "s_timeline": {"type": "object", "additionalProperties": false, "required": ["type", "row"],
                   "description": "每个事件提交后一条",
                   "properties": {"type": {"const": "timeline"}, "row": {"$ref": "#/$defs/timeline_row"}}},
    "s_busy": {"type": "object", "additionalProperties": false, "required": ["type", "on"],
               "description": "AI 回合进行中（输入框应禁用）",
               "properties": {"type": {"const": "busy"}, "on": {"type": "boolean"}}},
    "s_error": {"type": "object", "additionalProperties": false, "required": ["type", "message"],
                "properties": {"type": {"const": "error"}, "message": {"type": "string", "minLength": 1}}},
    "s_notice": {"type": "object", "additionalProperties": false, "required": ["type", "message"],
                 "description": "给玩家看的提示（引回选项、降级到纯选项、日记写好了）",
                 "properties": {"type": {"const": "notice"}, "message": {"type": "string", "minLength": 1}}},
    "s_saved": {"type": "object", "additionalProperties": false, "required": ["type", "slot", "turn"],
                "properties": {"type": {"const": "saved"}, "slot": {"type": "string"}, "turn": {"type": "integer", "minimum": 0}}},
    "s_snapshot": {"type": "object", "additionalProperties": false, "required": ["type", "save"],
                   "properties": {"type": {"const": "snapshot"}, "save": {"$ref": "#/$defs/save_blob"}}},
    "screen": {
      "type": "object", "additionalProperties": false,
      "description": "把一串 ops 折叠成的“那一刻的画面”（server/replay.py screen_from_ops）；restore 后为空对象",
      "properties": {
        "scene": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]},
        "bgm": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]},
        "sprite": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]},
        "say": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]},
        "choice": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]},
        "state": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]},
        "tail": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/render_op"}]}
      }
    },
    "s_screen": {
      "type": "object", "additionalProperties": false, "required": ["type", "screen", "live"],
      "description": "live=true：读档 / 重播跳转完成，当前进度就在这一刻（带 state）；live=false：时间轴拖动预览（带 seq、replay_ok），不改进度",
      "properties": {"type": {"const": "screen"}, "screen": {"$ref": "#/$defs/screen"}, "live": {"type": "boolean"},
                     "state": {"$ref": "#/$defs/state_op"}, "seq": {"type": "integer", "minimum": 0},
                     "replay_ok": {"type": "boolean"}, "line_id": {"type": ["string", "null"], "description": "VN Studio 句子 ID（那一刻的台词）"},
                     "replay": {"const": true}, "at": {"type": "integer", "minimum": 0}},
      "allOf": [{"if": {"properties": {"live": {"const": true}}, "required": ["live"]}, "then": {"required": ["state"]},
                 "else": {"required": ["seq", "replay_ok", "line_id"]}}]
    },
    "s_diary": {"type": "object", "additionalProperties": false, "required": ["type", "entries"],
                "properties": {"type": {"const": "diary"},
                               "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                     "required": ["text", "turn", "lineage"],
                                                                     "properties": {"text": {"type": "string"}, "turn": {"type": "integer"},
                                                                                    "lineage": {"type": "string"}}}}}},

    "main_s2c": {
      "title": "/ws 服务端 → 客户端",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["hello", "ops", "timeline", "busy", "error", "notice", "saved", "snapshot", "screen", "diary"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "hello"}}}, "then": {"$ref": "#/$defs/s_hello"}},
        {"if": {"properties": {"type": {"const": "ops"}}}, "then": {"$ref": "#/$defs/s_ops"}},
        {"if": {"properties": {"type": {"const": "timeline"}}}, "then": {"$ref": "#/$defs/s_timeline"}},
        {"if": {"properties": {"type": {"const": "busy"}}}, "then": {"$ref": "#/$defs/s_busy"}},
        {"if": {"properties": {"type": {"const": "error"}}}, "then": {"$ref": "#/$defs/s_error"}},
        {"if": {"properties": {"type": {"const": "notice"}}}, "then": {"$ref": "#/$defs/s_notice"}},
        {"if": {"properties": {"type": {"const": "saved"}}}, "then": {"$ref": "#/$defs/s_saved"}},
        {"if": {"properties": {"type": {"const": "snapshot"}}}, "then": {"$ref": "#/$defs/s_snapshot"}},
        {"if": {"properties": {"type": {"const": "screen"}}}, "then": {"$ref": "#/$defs/s_screen"}},
        {"if": {"properties": {"type": {"const": "diary"}}}, "then": {"$ref": "#/$defs/s_diary"}}
      ]
    },
    "screen_msg": {
      "description": "录进事件日志 sent 行的画面消息（ops / screen / notice）",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["ops", "screen", "notice"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "ops"}}}, "then": {"$ref": "#/$defs/s_ops"}},
        {"if": {"properties": {"type": {"const": "screen"}}}, "then": {"$ref": "#/$defs/s_screen"}},
        {"if": {"properties": {"type": {"const": "notice"}}}, "then": {"$ref": "#/$defs/s_notice"}}
      ]
    },

    "replay_control": {
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["pause", "resume", "play", "step", "speed", "jump", "seek", "stop"]}},
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["pause", "resume", "play", "step", "stop"]}}},
         "then": {"additionalProperties": false, "properties": {"type": true}}},
        {"if": {"properties": {"type": {"const": "speed"}}},
         "then": {"additionalProperties": false, "required": ["speed"],
                  "properties": {"type": true, "speed": {"type": ["number", "string"], "description": "倍速，服务端夹到 0.1–1000"}}}},
        {"if": {"properties": {"type": {"enum": ["jump", "seek"]}}},
         "then": {"additionalProperties": false, "anyOf": [{"required": ["step"]}, {"required": ["at"]}],
                  "properties": {"type": true, "step": {"type": "integer", "minimum": 0}, "at": {"type": "integer", "minimum": 0}}}}
      ]
    },
    "replay_c2s": {
      "title": "/ws/replay 客户端 → 服务端",
      "description": "控制消息；/ws 的玩家操作（advance / choose / input / mode / save / load / restore / snapshot）照收但不生效，回 replay.ignored",
      "anyOf": [{"$ref": "#/$defs/replay_control"},
                {"allOf": [{"$ref": "#/$defs/main_c2s"},
                           {"properties": {"type": {"enum": ["advance", "choose", "input", "mode", "save", "load", "restore", "snapshot"]}}}]}]
    },
    "s_replay": {
      "type": "object", "required": ["type", "event"],
      "description": "重播进度与控制回执",
      "properties": {"type": {"const": "replay"}, "event": {"enum": ["step", "choose", "input", "done", "diverged", "control", "ignored"]}},
      "allOf": [
        {"if": {"properties": {"event": {"const": "step"}}},
         "then": {"additionalProperties": false, "required": ["at", "steps", "seq", "kind"],
                  "properties": {"type": true, "event": true, "at": {"type": "integer", "minimum": 1}, "steps": {"type": "integer"},
                                 "seq": {"type": "integer"}, "kind": {"$ref": "event.schema.json#/$defs/kind"}}}},
        {"if": {"properties": {"event": {"const": "choose"}}},
         "then": {"additionalProperties": false, "required": ["option_id", "label", "seq"],
                  "properties": {"type": true, "event": true, "option_id": {"type": "string"}, "label": {"type": "string"}, "seq": {"type": "integer"}}}},
        {"if": {"properties": {"event": {"const": "input"}}},
         "then": {"additionalProperties": false, "required": ["text", "seq"],
                  "properties": {"type": true, "event": true, "text": {"type": "string"}, "seq": {"type": "integer"}}}},
        {"if": {"properties": {"event": {"const": "done"}}},
         "then": {"additionalProperties": false, "required": ["steps", "ok"],
                  "properties": {"type": true, "event": true, "steps": {"type": "integer"}, "ok": {"type": "boolean"}}}},
        {"if": {"properties": {"event": {"const": "diverged"}}},
         "then": {"additionalProperties": false, "required": ["seq", "step", "kind", "expected", "got", "message"],
                  "properties": {"type": true, "event": true, "seq": {"type": ["integer", "null"]}, "step": {"type": "integer"},
                                 "kind": {"type": ["string", "null"]}, "expected": {"type": ["string", "null"]},
                                 "got": {"type": ["string", "null"]}, "message": {"type": "string"}}}},
        {"if": {"properties": {"event": {"const": "control"}}},
         "then": {"additionalProperties": false, "required": ["id", "steps", "at", "speed", "paused", "recorded_screen"],
                  "properties": {"type": true, "event": true, "id": {"type": "string"}, "steps": {"type": "integer", "minimum": 0},
                                 "at": {"type": "integer", "minimum": 0}, "speed": {"type": "number", "exclusiveMinimum": 0},
                                 "paused": {"type": "boolean"}, "recorded_screen": {"type": "boolean"}}}},
        {"if": {"properties": {"event": {"const": "ignored"}}},
         "then": {"additionalProperties": false, "required": ["message", "of"],
                  "properties": {"type": true, "event": true, "message": {"type": "string"}, "of": {"type": "string"}}}}
      ]
    },
    "replay_s2c": {
      "title": "/ws/replay 服务端 → 客户端",
      "description": "与 /ws 相同的 hello / timeline / ops / screen / notice / error，另加 replay",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["hello", "timeline", "ops", "screen", "notice", "error", "replay"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "hello"}}}, "then": {"allOf": [{"$ref": "#/$defs/s_hello"}, {"required": ["replay"]}]}},
        {"if": {"properties": {"type": {"const": "timeline"}}}, "then": {"$ref": "#/$defs/s_timeline"}},
        {"if": {"properties": {"type": {"const": "ops"}}}, "then": {"$ref": "#/$defs/s_ops"}},
        {"if": {"properties": {"type": {"const": "screen"}}}, "then": {"$ref": "#/$defs/s_screen"}},
        {"if": {"properties": {"type": {"const": "notice"}}}, "then": {"$ref": "#/$defs/s_notice"}},
        {"if": {"properties": {"type": {"const": "error"}}}, "then": {"$ref": "#/$defs/s_error"}},
        {"if": {"properties": {"type": {"const": "replay"}}}, "then": {"$ref": "#/$defs/s_replay"}}
      ]
    },

    "tl": {"type": "object", "additionalProperties": false, "required": ["lineage", "turn"],
           "description": "时间线位置（前端自己维护存读档）",
           "properties": {"lineage": {"type": "string"}, "turn": {"type": "integer", "minimum": 0}}},
    "soul_c2s": {
      "title": "/ws/soul 客户端 → 服务端（vn-soul/1）",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["hello", "remember", "whisper"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "hello"}}},
         "then": {"additionalProperties": false, "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}}}},
        {"if": {"properties": {"type": {"const": "remember"}}},
         "then": {"additionalProperties": false, "anyOf": [{"required": ["ev"]}, {"required": ["text"]}],
                  "description": "把剧情事件写进记忆；kind 取 ev.type（fact / event / diary / dialogue，其它记为 event）",
                  "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"},
                                 "ev": {"type": "object", "additionalProperties": false,
                                        "properties": {"type": {"type": "string"}, "text": {"type": "string"}}},
                                 "text": {"type": "string"}, "tl": {"$ref": "#/$defs/tl"}}}},
        {"if": {"properties": {"type": {"const": "whisper"}}},
         "then": {"additionalProperties": false, "required": ["input"],
                  "description": "玩家在手账上写的一句（服务端截到 120 字）；vis 为可见时间线前缀",
                  "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}, "input": {"type": "string"},
                                 "talk": {"enum": ["short", "mid", "long"]}, "chapter": {"type": "string"},
                                 "history": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                       "properties": {"me": {"type": "boolean"}, "t": {"type": "string"}}}},
                                 "tl": {"$ref": "#/$defs/tl"}, "vis": {"type": "array", "items": {"$ref": "#/$defs/tl"}}}}}
      ]
    },
    "soul_s2c": {
      "title": "/ws/soul 服务端 → 客户端（vn-soul/1）",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["hello", "remembered", "whisper", "error"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "hello"}}},
         "then": {"additionalProperties": false, "required": ["protocol", "card", "llm", "memory", "expressions"],
                  "properties": {"type": true, "protocol": {"const": "vn-soul/1"}, "card": {"$ref": "#/$defs/card_brief"},
                                 "llm": {"type": "boolean"}, "memory": {"type": "boolean"},
                                 "expressions": {"type": "array", "items": {"type": "string"}}}}},
        {"if": {"properties": {"type": {"const": "remembered"}}},
         "then": {"additionalProperties": false, "required": ["id", "mid"],
                  "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}, "mid": {"type": ["string", "null"], "description": "记忆 ID；没有记忆插件或内容为空时为 null"}}}},
        {"if": {"properties": {"type": {"const": "whisper"}}},
         "then": {"required": ["id"],
                  "oneOf": [
                    {"title": "模型回复", "additionalProperties": false, "required": ["text", "lines", "emotion", "source", "recall"],
                     "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}, "text": {"type": "string", "minLength": 1},
                                    "lines": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
                                    "emotion": {"type": "string", "description": "卡里的立绘差分之一，或空串"},
                                    "source": {"const": "llm"}, "recall": {"type": "integer", "minimum": 0}}},
                    {"title": "前端用离线回复", "additionalProperties": false, "required": ["fallback", "reason"],
                     "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}, "fallback": {"const": true},
                                    "reason": {"enum": ["empty", "no_llm", "model_failed"]}}},
                    {"title": "输入越红线", "additionalProperties": false, "required": ["blocked", "reason"],
                     "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}, "blocked": {"const": true}, "reason": {"type": "string"}}}
                  ]}},
        {"if": {"properties": {"type": {"const": "error"}}},
         "then": {"additionalProperties": false, "required": ["message"],
                  "properties": {"type": true, "id": {"$ref": "#/$defs/msg_id"}, "message": {"type": "string", "minLength": 1}}}}
      ]
    },

    "ga_tool": {"type": "object", "additionalProperties": false, "required": ["name", "description", "effect", "policy", "source"],
                "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string"},
                               "effect": {"enum": ["read", "perform", "memory", "propose"]}, "policy": {"enum": ["auto", "ask", "deny"]},
                               "source": {"type": "string", "description": "提供它的插件 id，前端工具为 client"}}},
    "post_ending_c2s": {
      "title": "/ws/post_ending 客户端 → 服务端（galagent/1）",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["hello", "user", "approve", "client_result", "stop", "reset", "ping"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "hello"}}},
         "then": {"additionalProperties": false,
                  "description": "第一条必须是它；本机网页（Host 与 Origin 都是本机）免令牌",
                  "properties": {"type": true, "token": {"type": "string"}, "card": {"type": "string"},
                                 "character": {"type": "object", "additionalProperties": false,
                                               "properties": {"name": {"type": "string"}, "persona": {"type": "string"},
                                                              "expressions": {"type": "array", "items": {"type": "string"}}}},
                                 "context": {"type": "object", "additionalProperties": false,
                                             "properties": {"ending": {"type": "string"}, "story": {"type": "string"},
                                                            "vars": {"type": "object"}, "goal": {"type": "string"}}},
                                 "client_tools": {"type": "array", "maxItems": 32, "items": {
                                   "type": "object", "additionalProperties": false, "required": ["name"],
                                   "properties": {"name": {"type": "string"}, "description": {"type": "string"},
                                                  "parameters": {"type": "object"}, "effect": {"enum": ["read", "perform"]}}}},
                                 "history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "text"],
                                                                       "properties": {"role": {"type": "string"}, "text": {"type": "string"}}}},
                                 "server_tools": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "user"}}},
         "then": {"additionalProperties": false, "required": ["text"], "properties": {"type": true, "text": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "approve"}}},
         "then": {"additionalProperties": false, "required": ["call_id", "allow"],
                  "properties": {"type": true, "call_id": {"type": "string"}, "allow": {"type": "boolean"}, "remember": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "client_result"}}},
         "then": {"additionalProperties": false, "required": ["call_id", "ok"],
                  "properties": {"type": true, "call_id": {"type": "string"}, "ok": {"type": "boolean"}, "result": true,
                                 "error": {"type": ["string", "null"]}}}},
        {"if": {"properties": {"type": {"enum": ["stop", "reset", "ping"]}}},
         "then": {"additionalProperties": false, "properties": {"type": true}}}
      ]
    },
    "post_ending_s2c": {
      "title": "/ws/post_ending 服务端 → 客户端（galagent/1）",
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["ready", "turn_start", "turn_end", "round_start", "round_end", "step_start", "think_delta",
                                       "step_end", "say_delta", "emotion", "tool_start", "tool_end", "approval_required",
                                       "approval_resolved", "client_call", "usage", "error", "reset_done", "pong"]},
                     "turn": {"type": "integer", "minimum": 1}, "round": {"type": "integer", "minimum": 1},
                     "step": {"type": "string", "minLength": 1}, "call_id": {"type": "string"}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "ready"}}},
         "then": {"additionalProperties": false, "required": ["protocol", "session", "character", "llm", "tools"],
                  "properties": {"type": true, "protocol": {"const": "galagent/1"}, "session": {"type": "string"},
                                 "character": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}}},
                                 "llm": {"type": "boolean"}, "tools": {"type": "array", "items": {"$ref": "#/$defs/ga_tool"}}}}},
        {"if": {"properties": {"type": {"const": "turn_start"}}},
         "then": {"additionalProperties": false, "required": ["turn", "input"], "properties": {"type": true, "turn": true, "input": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "turn_end"}}},
         "then": {"additionalProperties": false, "required": ["turn", "ms", "rounds", "steps", "tool_calls", "reply", "stopped", "error"],
                  "properties": {"type": true, "turn": true, "ms": {"type": "integer", "minimum": 0}, "rounds": {"type": "integer", "minimum": 0},
                                 "steps": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0},
                                 "reply": {"type": "string"}, "stopped": {"type": "boolean"}, "error": {"type": ["string", "null"]}}}},
        {"if": {"properties": {"type": {"const": "round_start"}}},
         "then": {"additionalProperties": false, "required": ["turn", "round"], "properties": {"type": true, "turn": true, "round": true}}},
        {"if": {"properties": {"type": {"const": "round_end"}}},
         "then": {"additionalProperties": false, "required": ["turn", "round", "tool_calls"],
                  "properties": {"type": true, "turn": true, "round": true, "tool_calls": {"type": "integer", "minimum": 0}}}},
        {"if": {"properties": {"type": {"const": "step_start"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "kind"],
                  "properties": {"type": true, "turn": true, "step": true, "kind": {"const": "think"}}}},
        {"if": {"properties": {"type": {"const": "think_delta"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "text"], "properties": {"type": true, "turn": true, "step": true, "text": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "step_end"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "ok", "ms"],
                  "properties": {"type": true, "turn": true, "step": true, "ok": {"type": "boolean"}, "ms": {"type": "integer", "minimum": 0}}}},
        {"if": {"properties": {"type": {"const": "say_delta"}}},
         "then": {"additionalProperties": false, "required": ["turn", "round", "text"], "properties": {"type": true, "turn": true, "round": true, "text": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "emotion"}}},
         "then": {"additionalProperties": false, "required": ["turn", "name"], "properties": {"type": true, "turn": true, "name": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "tool_start"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "call_id", "name", "args", "source", "policy"],
                  "properties": {"type": true, "turn": true, "step": true, "call_id": true, "name": {"type": "string"}, "args": true,
                                 "source": {"type": "string"}, "policy": {"enum": ["auto", "ask", "deny"]}}}},
        {"if": {"properties": {"type": {"const": "tool_end"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "call_id", "name", "ok", "result", "error", "ms"],
                  "properties": {"type": true, "turn": true, "step": true, "call_id": true, "name": {"type": "string"}, "ok": {"type": "boolean"},
                                 "result": true, "error": {"type": ["string", "null"]}, "ms": {"type": "integer", "minimum": 0}}}},
        {"if": {"properties": {"type": {"const": "approval_required"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "call_id", "name", "args", "effect"],
                  "properties": {"type": true, "turn": true, "step": true, "call_id": true, "name": {"type": "string"}, "args": true,
                                 "effect": {"enum": ["read", "perform", "memory", "propose"]}}}},
        {"if": {"properties": {"type": {"const": "approval_resolved"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "call_id", "allow"],
                  "properties": {"type": true, "turn": true, "step": true, "call_id": true, "allow": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "client_call"}}},
         "then": {"additionalProperties": false, "required": ["turn", "step", "call_id", "name", "args"],
                  "properties": {"type": true, "turn": true, "step": true, "call_id": true, "name": {"type": "string"}, "args": {"type": "object"}}}},
        {"if": {"properties": {"type": {"const": "usage"}}},
         "then": {"additionalProperties": false, "required": ["turn", "round", "prompt_tokens", "completion_tokens"],
                  "properties": {"type": true, "turn": true, "round": true, "prompt_tokens": {"type": ["integer", "null"]},
                                 "completion_tokens": {"type": ["integer", "null"]}}}},
        {"if": {"properties": {"type": {"const": "error"}}},
         "then": {"additionalProperties": false, "required": ["message"],
                  "properties": {"type": true, "message": {"type": "string", "minLength": 1}, "turn": true,
                                 "fatal": {"type": "boolean", "description": "true = 连接不可用，服务端随后关闭"},
                                 "code": {"enum": ["auth"]}}}},
        {"if": {"properties": {"type": {"enum": ["reset_done", "pong"]}}},
         "then": {"additionalProperties": false, "properties": {"type": true}}}
      ]
    }
  }
}
