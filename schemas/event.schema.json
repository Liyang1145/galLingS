{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallings.dev/schemas/event.schema.json",
  "title": "galLingS 事件日志（events.jsonl 的一行）",
  "description": "PLAN §4.1–4.2。JSONL，追加写，一行一个 JSON；唯一写入者是 server/recorder.py。第 1 行是 header；之后是事件行（喂给引擎、回放逐条比对 state_hash），以及只给录制回放演示模式用的 sent 行（那一刻真正发给前端的画面消息，不进引擎）。字段以实际代码为准：事件行用 verdicts 数组（引擎 step 的返回），回合号 / 时间线在引擎状态里，不在行上。",
  "oneOf": [
    {
      "$ref": "#/$defs/header"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/sent"
    }
  ],
  "$defs": {
    "hash16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "kind": {
      "description": "事件种类：引擎 core/src/engine.rs Engine::step 认得的全部种类。director 引擎已实现，会话目前不发。",
      "enum": [
        "start",
        "advance",
        "choice",
        "player_input",
        "intent",
        "turn_begin",
        "model_tool_call",
        "turn_commit",
        "turn_abort",
        "director",
        "mode_switch",
        "fallback",
        "memory_write",
        "load",
        "text_verdict",
        "memory_recall",
        "save",
        "perform",
        "diary_view"
      ]
    },
    "source": {
      "enum": [
        "player",
        "model",
        "guard",
        "memory",
        "director",
        "engine"
      ]
    },
    "empty": {
      "type": "object",
      "maxProperties": 0
    },
    "header_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "log_version",
        "engine_version",
        "content_hash",
        "chapter_path",
        "card_id",
        "card_hash",
        "engine_config",
        "seed",
        "lineage",
        "prompt_version",
        "plugins",
        "config_hash"
      ],
      "properties": {
        "kind": {
          "const": "header"
        },
        "log_version": {
          "const": 1
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "content_hash": {
          "$ref": "#/$defs/hash16"
        },
        "chapter_path": {
          "type": "string",
          "minLength": 1,
          "description": "回放时按它找剧本（换机器时按 content_hash 在候选里找）"
        },
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "card_hash": {
          "$ref": "#/$defs/hash16"
        },
        "card": {
          "$ref": "card.schema.json",
          "description": "整张角色卡（回放建引擎用）；ws hello 里的 header 去掉这一项"
        },
        "engine_config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "choice",
                "ai"
              ]
            },
            "honesty_gap_rule": {
              "type": "boolean"
            },
            "honesty_gap": {
              "type": "integer"
            },
            "intent_threshold_milli": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "tsundere_defer_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "vars_init": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "plugins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "plugins",
            "select",
            "lock_sha256"
          ],
          "description": "插件锁（server/plugins 的 lock()）",
          "properties": {
            "engine": {
              "type": "string"
            },
            "plugins": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "kind",
                  "api",
                  "runtime",
                  "manifest_sha256",
                  "config_sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "api": {
                    "type": "integer"
                  },
                  "runtime": {
                    "type": "string"
                  },
                  "manifest_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "config_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "select": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "config_hash": {
          "$ref": "#/$defs/hash16"
        }
      }
    },
    "header": {
      "allOf": [
        {
          "$ref": "#/$defs/header_fields"
        },
        {
          "required": [
            "card"
          ]
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "rule",
        "applied",
        "reason"
      ],
      "description": "引擎裁决（PLAN §4.3）。rule 为空串表示原样通过。",
      "properties": {
        "result": {
          "enum": [
            "applied",
            "clamped",
            "rejected"
          ]
        },
        "rule": {
          "enum": [
            "",
            "intent_matched",
            "off_script",
            "unknown_option",
            "steer_back",
            "input_closed",
            "turn_say_limit",
            "chapter_budget",
            "step_clamp",
            "unknown_signal",
            "ai_tail_max",
            "tail_total_max",
            "honesty_gap",
            "mood_clamp",
            "unknown_sprite",
            "demo_branch_closed",
            "director_only",
            "taboo_director_only",
            "reserved",
            "unknown_tool",
            "taboo_not_authorized",
            "unknown_director_action"
          ]
        },
        "applied": {
          "type": [
            "object",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "kind",
        "source",
        "payload",
        "verdicts",
        "state_hash",
        "wall_ms"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "引擎提交这个事件后的 state.seq（从 1 起，严格递增）"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "payload": {
          "type": "object"
        },
        "verdicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verdict"
          }
        },
        "state_hash": {
          "$ref": "#/$defs/hash16",
          "description": "提交后状态的 FNV-1a 64（规范化 JSON）"
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "只给时间轴 / 重播定节奏，不参与计算"
        },
        "display": {
          "type": "object",
          "description": "只给时间轴看的附加说明，不参与回放"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/payload_by_kind"
        }
      ]
    },
    "p_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pc"
      ],
      "description": "从某一章开头开局（VN Studio 作品），pc 必须指向 CHAPTER；只能是第一个事件",
      "properties": {
        "pc": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "p_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "p_player_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "p_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "matched_option",
        "confidence_milli"
      ],
      "description": "意图分类结果。matched_option 非空且置信度 ≥ 阈值时引擎按原选项走",
      "properties": {
        "intent": {
          "type": "string"
        },
        "matched_option": {
          "type": "string"
        },
        "confidence_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "by": {
          "enum": [
            "literal",
            "offline",
            "model",
            "fallback"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "p_text_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "allow",
        "rule",
        "reason",
        "hint",
        "text",
        "guard_version"
      ],
      "description": "文本守卫结论（server/guard）。stage=input 是玩家输入（plugin 有值 = guard 插件的结论），sentence 是模型的一句（attempt 0–2 为重写次数），perform 是换卡演绎层改写的剧本台词（src 为原台词），tool 是严肃模板下会话层驳回的工具调用（tool / args）；memory 是记忆修订被拒（整合方案 W2：没有本轮 read_token、来源权级不够或插件不支持 mark）",
      "properties": {
        "stage": {
          "enum": [
            "input",
            "sentence",
            "perform",
            "tool",
            "memory"
          ]
        },
        "src": {
          "type": ["string", "null"]
        },
        "plugin": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "allow": {
          "type": "boolean"
        },
        "rule": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "guard_version": {
          "type": "string"
        }
      }
    },
    "memory_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "score",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AGM 联想路径（agm 补位条目才有）"
        },
        "provenance": {
          "enum": ["script", "engine", "player_claim", "heroine_line", "model_note", "unknown"],
          "description": "记忆来源（整合方案 W1，server/memory/provenance.py）；与 source（哪个检索器召回的）不是一回事"
        },
        "kind": {
          "type": ["string", "null"]
        },
        "evidence_key": {
          "type": "string",
          "description": "sha1(来源 + 规范化原文) 前 16 位；召回按它去重（重复不等于证据）"
        },
        "as_of_turn": {
          "type": "integer",
          "description": "条目带数量 / 归属 / 称呼时：这是第几回合时的说法，当前真值只认引擎状态（W3）"
        },
        "stance": {
          "type": "string",
          "description": "确定性态度过滤的注记（R1，server/memory/stance.py），不写回记忆"
        },
        "show": {
          "type": "boolean",
          "description": "false = 态度过滤判定这条不进提示词"
        },
        "stance_rule": {
          "type": "string"
        }
      }
    },
    "timeline_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage",
        "turn"
      ],
      "properties": {
        "lineage": {
          "type": "string"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "p_memory_recall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "hits",
        "agm",
        "visible"
      ],
      "description": "召回结果原样入日志，回放不再查记忆（PLAN §4.1-4）",
      "properties": {
        "query": {
          "type": "string"
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memory_hit"
          }
        },
        "agm": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/memory_hit"
              },
              {
                "required": [
                  "path"
                ],
                "properties": {
                  "source": {
                    "const": "agm_fill"
                  }
                }
              }
            ]
          }
        },
        "visible": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeline_prefix"
          }
        },
        "read_token": {
          "type": "string",
          "description": "本次召回的先读后写令牌（W2：修订必须带本轮召回给的令牌）"
        },
        "deduped": {
          "type": "integer",
          "description": "同 evidence_key 去掉的条数"
        },
        "stance": {
          "type": "object",
          "description": "态度过滤用到的状态与被隐藏的条目（R1）"
        }
      }
    },
    "p_memory_write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cooccur",
        "ids"
      ],
      "description": "cooccur 进 AGM 共现图（边带当前时间线与回合）",
      "properties": {
        "cooccur": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diary": {
          "const": true
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "修订作废的旧条目（W2）：旧条只打 superseded，原文不删"
        },
        "revise": {
          "const": true
        },
        "memory_source": {
          "type": "string"
        }
      }
    },
    "p_model_tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "description": "模型（或导演代发的默认台词）的一次工具调用；工具名不在 schemas/tools.json 里也照记，引擎裁成 unknown_tool",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "memory_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_source": {
          "type": "string",
          "description": "write_memory 写入的来源（恒为 model_note，W1）"
        },
        "emotion": {
          "type": "string",
          "description": "say 的情绪标签（E1）"
        },
        "emotion_mood_conflict": {
          "const": true,
          "description": "情绪标签与 mood 方向冲突（时间轴标红、评测计数，不驳回）"
        },
        "via": {
          "type": "string",
          "description": "set_sprite 由 say.emotion 映射而来时为 say.emotion"
        }
      }
    },
    "p_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason"
      ],
      "description": "降级阶梯（PLAN §5.4）：L2 默认台词、L3 回合失败、L4 本场退回纯选项",
      "properties": {
        "level": {
          "enum": [
            2,
            3,
            4
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string"
        },
        "src": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "p_director": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "steer_back / taboo_event；其它被裁成 unknown_director_action"
        }
      }
    },
    "p_mode_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "choice",
            "ai"
          ]
        }
      }
    },
    "p_save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "p_load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "snapshot",
        "new_lineage"
      ],
      "description": "读档 = 新时间线（PLAN §13.3）。整份引擎快照入日志，回放据此恢复",
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "#/$defs/engine_snapshot"
        },
        "new_lineage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "p_perform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "origin",
        "text"
      ],
      "description": "演绎层（非原作卡）把一句剧本台词改写后的结果；回放 / 重播直接用它",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "performed",
            "fallback"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "engine_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "content_hash",
        "state",
        "agm"
      ],
      "description": "Engine::snapshot() 的 JSON（state 为引擎完整状态，结构见 core/src/engine.rs State）",
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/hash16"
        },
        "state": {
          "type": "object",
          "required": [
            "seq",
            "turn",
            "pc",
            "wait",
            "mode",
            "lineage",
            "lineages",
            "affection",
            "rng"
          ],
          "properties": {
            "wait": {
              "enum": [
                "ready",
                "say",
                "choice",
                "end"
              ]
            },
            "mode": {
              "enum": [
                "choice",
                "ai"
              ]
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "turn": {
              "type": "integer",
              "minimum": 0
            },
            "pc": {
              "type": "integer",
              "minimum": 0
            },
            "lineage": {
              "type": "string"
            },
            "lineages": {
              "type": "object"
            },
            "affection": {
              "type": "integer"
            },
            "rng": {
              "type": "object"
            }
          }
        },
        "agm": {
          "type": "object"
        }
      }
    },
    "sent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "after_seq",
        "msg"
      ],
      "description": "录制回放演示模式用：那一刻发给前端的画面消息（ops / screen / notice），挂在 after_seq 这个事件之后（0 = 第一个事件之前）。read_log 跳过它",
      "properties": {
        "kind": {
          "const": "sent"
        },
        "after_seq": {
          "type": "integer",
          "minimum": 0
        },
        "msg": {
          "$ref": "ws.schema.json#/$defs/screen_msg"
        }
      }
    },
    "payload_by_kind": {
      "description": "按 kind 校验 payload（事件行与时间轴行共用）",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "start"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/p_start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "advance",
                  "turn_begin",
                  "turn_commit",
