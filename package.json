{
  "name": "haifeng-pudding-rebuild",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "content:build": "node tools/content/build.ts",
    "story:dev": "node tools/dev/story.ts",
    "game:dev": "vite --config tools/dev/vite.config.ts",
    "editor:dev": "vite --config tools/editor/vite.config.ts",
    "editor:build": "node tools/editor/build.ts",
    "editor:serve": "node tools/editor/serve.ts",
    "editor:test": "node --test tests/editor/*.test.ts",
    "editor:test:browser": "node tests/editor/browser.mjs",
    "editor:test:production": "node tests/editor/production.mjs",
    "game:build": "node tools/game/build.ts",
    "game:verify": "node tools/game/verify.ts",
    "windows:prepare": "node tools/game/windows.ts",
    "linux:prepare": "node tools/game/linux.ts",
    "android:prepare": "node tools/game/android.ts",
    "chat:test": "node --test tests/chat/*.test.mjs",
    "chat:test:browser": "node tests/chat/browser.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
