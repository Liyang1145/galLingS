{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallings.dev/schemas/op.schema.json",
  "title": "galLingS 章节 JSON 与 OP 指令",
  "description": "PLAN §6.4–6.5。编译产物（compiler/compile.py 的 Markdown 剧本、compiler/vnstudio.py 的 VN Studio 导入）是一段扁平 OP 程序：program[pc] 顺序执行，JUMP / JUMP_IF / CHOICE 的目标是 pc 下标。顶层 = 章节；$defs/program_op = 章节里的 OP；$defs/render_op = 引擎 step() 吐给前端的 OP（ws `ops` 消息里的元素，多了 STATE / RESTORE 与 AI 即兴产生的 SAY / TAIL / SPRITE，CHOICE 的 target 已被去掉）。以实际代码产出的数据为准，契约测试 tests/contract/test_schemas.py。",
  "$ref": "#/$defs/chapter",
  "$defs": {
    "hash16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "pc": {"type": "integer", "minimum": 0},
    "src": {"type": "string", "minLength": 1, "description": "剧本定位：Markdown 为 `文件名:行号`，VN Studio 为 `vn:<句子ID>`（文件末尾的 END 为 `vn:<eof>`）"},
    "range": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},

    "chapter": {
      "type": "object",
      "required": ["chapter_id", "title", "program", "rules", "analysis", "slots", "content_hash"],
      "properties": {
        "schema_version": {"const": 1},
        "compiler_version": {"type": "string"},
        "format": {"const": "gallings.chapter/1"},
        "chapter_id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "program": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/program_op"}},
        "rules": {"$ref": "#/$defs/rules"},
        "analysis": {"$ref": "#/$defs/analysis"},
        "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
        "scene_tags": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "game", "lines", "heroine"],
          "properties": {
            "kind": {"const": "vnstudio"},
            "game": {"type": "string"},
            "vn_version": {"type": ["integer", "string", "null"]},
            "lines": {"type": "integer", "minimum": 1},
            "heroine": {"type": "string"}
          }
        },
        "asset_base": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"$ref": "#/$defs/pc"}},
        "vars": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "var", "init"],
            "properties": {"name": {"type": ["string", "null"]}, "var": {"type": "string"}, "init": {"type": "integer"}}
          }
        },
        "content_hash": {"$ref": "#/$defs/hash16"}
      },
      "additionalProperties": false,
      "oneOf": [
        {"title": "Markdown 剧本编译（compiler/compile.py）",
         "required": ["schema_version", "compiler_version", "scene_tags", "warnings"],
         "not": {"anyOf": [{"required": ["format"]}, {"required": ["source"]}]}},
        {"title": "VN Studio 导入（compiler/vnstudio.py）",
         "required": ["format", "source", "asset_base", "labels", "vars"],
         "not": {"anyOf": [{"required": ["schema_version"]}, {"required": ["warnings"]}]}}
      ]
    },

    "rules": {
      "type": "object", "additionalProperties": false, "required": ["affection_range"],
      "description": "引擎裁决参数（PLAN §8.2）。VN Studio 导入只有 affection_range，其余取引擎默认。",
      "properties": {
        "affection_range": {"$ref": "#/$defs/range"},
        "ai_tail_max": {"type": "integer", "minimum": 0},
        "tail_total_max": {"type": "integer", "minimum": 0},
        "step_clamp": {"type": "integer", "minimum": 0},
        "excursion_net_max": {"type": "integer", "minimum": 0},
        "ai_rounds_max": {"type": "integer", "minimum": 1}
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false, "required": ["rem"],
      "properties": {
        "affection": {"$ref": "#/$defs/range"},
        "tails": {"$ref": "#/$defs/range"},
        "rem": {"type": "object", "description": "pc（字符串）→ 之后剧本还能给出的好感 [最小, 最大]（运行时预算用）",
                "propertyNames": {"pattern": "^[0-9]+$"}, "additionalProperties": {"$ref": "#/$defs/range"}},
        "unreachable": {"type": "array", "items": {"$ref": "#/$defs/pc"}},
        "dead_ends": {"type": "array", "items": {"$ref": "#/$defs/pc"}}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["literal", "slot", "type", "uses"],
      "properties": {"literal": {"type": "string", "minLength": 1}, "slot": {"type": "string", "minLength": 1},
                     "type": {"type": "string"}, "uses": {"type": "integer", "minimum": 0}}
    },

    "set_list": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["var", "op", "value"],
                "properties": {"var": {"type": "string", "minLength": 1, "description": "affection / tails 为角色状态通道，其余进通用 vars"},
                               "op": {"enum": ["=", "+=", "-="]}, "value": {"type": "integer"}}}
    },
    "cond_list": {
      "type": "array", "minItems": 1, "description": "全部成立才算成立",
      "items": {"type": "object", "additionalProperties": false, "required": ["var", "cmp", "value"],
                "properties": {"var": {"type": "string", "minLength": 1},
                               "cmp": {"enum": ["<", "<=", ">", ">=", "==", "!="]}, "value": {"type": "integer"}}}
    },
    "choice_option": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "nature": {"type": "string", "description": "选项性质（顺毛 / 作死 / 诚实笨拙…），意图分类用；Markdown 剧本才有"},
        "target": {"$ref": "#/$defs/pc"},
        "set": {"$ref": "#/$defs/set_list"},
        "cond": {"$ref": "#/$defs/cond_list"}
      }
    },

    "op_names": {"enum": ["SAY", "CHOICE", "BEAT", "SCENE", "BGM", "SPRITE", "TAIL", "AFFECT", "JUMP", "JUMP_IF", "MERGE",
                          "SAVEPOINT", "END", "CG", "CHAPTER", "SET", "FLAG", "CALL", "STATE", "RESTORE"]},

    "op_SAY": {
      "type": "object", "additionalProperties": false, "required": ["op", "speaker", "text", "layer", "origin"],
      "properties": {
        "op": {"const": "SAY"}, "src": {"$ref": "#/$defs/src"},
        "id": {"type": "string", "description": "VN Studio 句子 ID（播放器按它渲染）"},
        "speaker": {"type": "string", "minLength": 1, "description": "heroine / player / narrator，或 VN Studio 里的其他角色名原样"},
        "name": {"type": "string", "description": "VN Studio 原始说话人名（旁白为空串）"},
        "text": {"type": "string"},
        "layer": {"enum": ["line", "narration", "action"], "description": "台词 / 旁白 / 括号动作描写"},
        "origin": {"enum": ["locked", "script", "improvised", "fallback", "performed"]},
        "voice": {"type": ["string", "null"], "description": "TTS 预留，目前恒为 null"},
        "hash": {"$ref": "#/$defs/hash16", "description": "锁定台词的 sha256 前 16 位（origin=locked）"},
        "slots": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "pause": {"const": true, "description": "VN Studio 空句（只停一下）"}
      }
    },
    "op_CHOICE": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "beat_id", "options"],
      "properties": {
        "op": {"const": "CHOICE"}, "src": {"$ref": "#/$defs/src"},
        "id": {"type": "string", "minLength": 1},
        "beat_id": {"type": "string"},
        "line_id": {"type": "string"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/choice_option"}},
        "default_line": {"type": "string", "description": "这一拍女主最后一句锁定台词，AI 失败时的默认衔接"},
        "timeout": {"type": "object", "additionalProperties": false, "required": ["seconds", "default_option"],
                    "properties": {"seconds": {"type": "integer", "minimum": 1}, "default_option": {"type": "string"}}}
      }
    },
    "op_BEAT": {
      "type": "object", "additionalProperties": false, "required": ["op", "beat_id"],
      "properties": {"op": {"const": "BEAT"}, "src": {"$ref": "#/$defs/src"}, "beat_id": {"type": "string", "minLength": 1},
                     "purpose": {"type": "string"}, "emotion_target": {"type": "string"}}
    },
    "op_SCENE": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "bg"],
      "properties": {"op": {"const": "SCENE"}, "src": {"$ref": "#/$defs/src"}, "id": {"type": "string", "minLength": 1},
                     "bg": {"type": "string"}, "time": {"type": "string"}, "event": {"type": "string"}, "name": {"type": "string"}}
    },
    "op_BGM": {
      "type": "object", "additionalProperties": false, "required": ["op", "id"],
      "properties": {"op": {"const": "BGM"}, "src": {"$ref": "#/$defs/src"},
                     "id": {"type": ["string", "null"], "description": "null = 停止音乐（VN Studio）"},
                     "fade_in": {"type": "integer", "minimum": 0}, "fade_out": {"type": "integer", "minimum": 0},
                     "file": {"type": "string"}}
    },
    "op_SPRITE": {
      "type": "object", "additionalProperties": false, "required": ["op", "card", "expr", "pos", "kind"],
      "properties": {"op": {"const": "SPRITE"}, "src": {"$ref": "#/$defs/src"}, "card": {"type": "string"},
                     "expr": {"type": ["string", "null"], "description": "null = 退场"}, "pos": {"type": "string"},
                     "kind": {"enum": ["static", "live2d"]}}
    },
    "op_TAIL": {
      "type": "object", "additionalProperties": false, "required": ["op", "signal_id", "count", "source"],
      "properties": {"op": {"const": "TAIL"}, "src": {"$ref": "#/$defs/src"}, "signal_id": {"type": "string", "minLength": 1},
                     "count": {"type": "integer", "minimum": 1}, "desc": {"type": "string"}, "noticed": {"type": "boolean"},
                     "source": {"enum": ["script", "ai"]}, "meaning": {"type": "string"}}
    },
    "op_AFFECT": {
      "type": "object", "additionalProperties": false, "required": ["op", "surface"],
      "properties": {"op": {"const": "AFFECT"}, "src": {"$ref": "#/$defs/src"}, "surface": {"type": "integer"},
                     "inner": {"type": ["integer", "null"], "description": "null = 与 surface 相同"},
                     "reason": {"type": "string"}, "source": {"const": "script"}}
    },
    "op_JUMP": {
      "type": "object", "additionalProperties": false, "required": ["op", "target"],
      "properties": {"op": {"const": "JUMP"}, "src": {"$ref": "#/$defs/src"}, "target": {"$ref": "#/$defs/pc"}}
    },
    "op_JUMP_IF": {
      "type": "object", "additionalProperties": false, "required": ["op", "cond", "target"],
      "properties": {"op": {"const": "JUMP_IF"}, "src": {"$ref": "#/$defs/src"}, "cond": {"$ref": "#/$defs/cond_list"},
                     "target": {"$ref": "#/$defs/pc"}}
    },
    "op_MERGE": {
      "type": "object", "additionalProperties": false, "required": ["op", "id"],
      "properties": {"op": {"const": "MERGE"}, "src": {"$ref": "#/$defs/src"}, "id": {"type": "string"}}
    },
    "op_SAVEPOINT": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "name"],
      "properties": {"op": {"const": "SAVEPOINT"}, "src": {"$ref": "#/$defs/src"}, "id": {"type": "string"}, "name": {"type": "string"}}
    },
    "op_END": {
      "type": "object", "additionalProperties": false, "required": ["op", "ending_id", "kind"],
      "properties": {"op": {"const": "END"}, "src": {"$ref": "#/$defs/src"}, "ending_id": {"type": "string", "minLength": 1},
                     "kind": {"enum": ["chapter", "ending", "script_end"]}}
    },
    "op_CG": {
      "type": "object", "additionalProperties": false, "required": ["op", "id"],
      "properties": {"op": {"const": "CG"}, "src": {"$ref": "#/$defs/src"}, "id": {"type": "string"}, "desc": {"type": "string"}}
    },
    "op_CHAPTER": {
      "type": "object", "additionalProperties": false, "required": ["op", "id", "title"],
      "properties": {"op": {"const": "CHAPTER"}, "src": {"$ref": "#/$defs/src"}, "id": {"type": "string"}, "title": {"type": "string"}}
    },
    "op_SET": {
      "type": "object", "additionalProperties": false, "required": ["op", "set"],
      "properties": {"op": {"const": "SET"}, "src": {"$ref": "#/$defs/src"}, "set": {"$ref": "#/$defs/set_list"}}
    },
    "op_FLAG": {
      "type": "object", "additionalProperties": false, "required": ["op", "key", "value"],
      "description": "引擎已实现（写 state.flags），编译器尚未产出",
      "properties": {"op": {"const": "FLAG"}, "src": {"$ref": "#/$defs/src"}, "key": {"type": "string"}, "value": {"type": "string"}}
    },
    "op_CALL": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "description": "引擎已实现（address_stage + 1），编译器尚未产出；字段按 PLAN §6.5",
      "properties": {"op": {"const": "CALL"}, "src": {"$ref": "#/$defs/src"}, "who": {"type": "string"}, "name": {"type": "string"}}
    },
    "op_STATE": {
      "type": "object", "additionalProperties": false,
      "description": "引擎每步末尾附带的显示用状态（只出现在 render_op）",
      "required": ["op", "affection", "tails", "mood", "address_stage", "wound", "mode", "input_open", "lineage", "turn", "wait"],
      "properties": {"op": {"const": "STATE"}, "affection": {"type": "integer"}, "tails": {"type": "integer", "minimum": 0},
                     "mood": {"type": "integer", "minimum": -5, "maximum": 5}, "address_stage": {"type": "integer", "minimum": 0},
                     "wound": {"enum": ["none", "angry", "dead", "reconciled"]}, "mode": {"enum": ["choice", "ai"]},
                     "input_open": {"type": "boolean"}, "lineage": {"type": "string", "minLength": 1},
                     "turn": {"type": "integer", "minimum": 0}, "wait": {"enum": ["ready", "say", "choice", "end"]}}
    },
    "op_RESTORE": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "description": "读档事件后引擎吐出（前端清屏重画；只出现在 render_op）",
      "properties": {"op": {"const": "RESTORE"}}
    },

    "any_op": {
      "type": "object", "required": ["op"],
      "properties": {"op": {"$ref": "#/$defs/op_names"}},
      "allOf": [
        {"if": {"properties": {"op": {"const": "SAY"}}}, "then": {"$ref": "#/$defs/op_SAY"}},
        {"if": {"properties": {"op": {"const": "CHOICE"}}}, "then": {"$ref": "#/$defs/op_CHOICE"}},
        {"if": {"properties": {"op": {"const": "BEAT"}}}, "then": {"$ref": "#/$defs/op_BEAT"}},
        {"if": {"properties": {"op": {"const": "SCENE"}}}, "then": {"$ref": "#/$defs/op_SCENE"}},
        {"if": {"properties": {"op": {"const": "BGM"}}}, "then": {"$ref": "#/$defs/op_BGM"}},
        {"if": {"properties": {"op": {"const": "SPRITE"}}}, "then": {"$ref": "#/$defs/op_SPRITE"}},
        {"if": {"properties": {"op": {"const": "TAIL"}}}, "then": {"$ref": "#/$defs/op_TAIL"}},
        {"if": {"properties": {"op": {"const": "AFFECT"}}}, "then": {"$ref": "#/$defs/op_AFFECT"}},
        {"if": {"properties": {"op": {"const": "JUMP"}}}, "then": {"$ref": "#/$defs/op_JUMP"}},
        {"if": {"properties": {"op": {"const": "JUMP_IF"}}}, "then": {"$ref": "#/$defs/op_JUMP_IF"}},
        {"if": {"properties": {"op": {"const": "MERGE"}}}, "then": {"$ref": "#/$defs/op_MERGE"}},
        {"if": {"properties": {"op": {"const": "SAVEPOINT"}}}, "then": {"$ref": "#/$defs/op_SAVEPOINT"}},
        {"if": {"properties": {"op": {"const": "END"}}}, "then": {"$ref": "#/$defs/op_END"}},
        {"if": {"properties": {"op": {"const": "CG"}}}, "then": {"$ref": "#/$defs/op_CG"}},
        {"if": {"properties": {"op": {"const": "CHAPTER"}}}, "then": {"$ref": "#/$defs/op_CHAPTER"}},
        {"if": {"properties": {"op": {"const": "SET"}}}, "then": {"$ref": "#/$defs/op_SET"}},
        {"if": {"properties": {"op": {"const": "FLAG"}}}, "then": {"$ref": "#/$defs/op_FLAG"}},
        {"if": {"properties": {"op": {"const": "CALL"}}}, "then": {"$ref": "#/$defs/op_CALL"}},
        {"if": {"properties": {"op": {"const": "STATE"}}}, "then": {"$ref": "#/$defs/op_STATE"}},
        {"if": {"properties": {"op": {"const": "RESTORE"}}}, "then": {"$ref": "#/$defs/op_RESTORE"}}
      ]
    },

    "program_op": {
      "description": "章节 program 里的 OP：必须带 src；STATE / RESTORE 不会出现；CHOICE 的每个选项必须有 target，至少一个选项。",
      "allOf": [
        {"$ref": "#/$defs/any_op"},
        {"required": ["src"], "properties": {"op": {"not": {"enum": ["STATE", "RESTORE"]}}}},
        {"if": {"properties": {"op": {"const": "CHOICE"}}},
         "then": {"properties": {"options": {"minItems": 1, "items": {"required": ["target"]}}}}}
      ]
    },
    "render_op": {
      "description": "引擎下发给前端的 OP（ws `ops`）：JUMP / JUMP_IF / MERGE / BEAT / FLAG 是控制流，不下发；CHOICE 选项不带 target，条件不满足的选项已滤掉。",
      "allOf": [
        {"$ref": "#/$defs/any_op"},
        {"properties": {"op": {"not": {"enum": ["JUMP", "JUMP_IF", "MERGE", "BEAT", "FLAG"]}}}},
        {"if": {"properties": {"op": {"const": "CHOICE"}}},
         "then": {"properties": {"options": {"items": {"not": {"required": ["target"]}}}}}}
      ]
    }
  }
}
