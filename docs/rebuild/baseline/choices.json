  {"id":"choice-000003","nodeId":"kq4s0fev","sourceIndex":2,"legacy":{"text":"番外篇二 · 贝壳项链","target":"番外二","cond":"","set":""}},
  {"id":"choice-000004","nodeId":"irma08fi","sourceIndex":0,"legacy":{"text":"「我可以解释——」","target":"c1q1a","cond":"","set":""}},
  {"id":"choice-000005","nodeId":"irma08fi","sourceIndex":1,"legacy":{"text":"「沉默」","target":"c1q1b","cond":"","set":"好感 -= 10"}},
  {"id":"choice-000006","nodeId":"irma08fi","sourceIndex":2,"legacy":{"text":"「……手感不错。」","target":"c1q1c","cond":"","set":"好感 -= 5"}},
  {"id":"choice-000007","nodeId":"vfo56g8o","sourceIndex":0,"legacy":{"text":"「你的尾巴重要。」","target":"c1q2a","cond":"","set":"好感 += 10"}},
  {"id":"choice-000008","nodeId":"vfo56g8o","sourceIndex":1,"legacy":{"text":"「本子重要。」","target":"c1q2b","cond":"","set":"好感 -= 10"}},
  {"id":"choice-000009","nodeId":"vfo56g8o","sourceIndex":2,"legacy":{"text":"「都重要。」","target":"c1q2c","cond":"","set":"好感 += 3"}},
  {"id":"choice-000010","nodeId":"fm43foif","sourceIndex":0,"legacy":{"text":"「记一个问题的答案。」","target":"c1q3a","cond":"","set":""}},
  {"id":"choice-000011","nodeId":"fm43foif","sourceIndex":1,"legacy":{"text":"「记你。」","target":"c1q3b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000012","nodeId":"fm43foif","sourceIndex":2,"legacy":{"text":"「商业机密。」","target":"c1q3c","cond":"","set":"好感 -= 2"}},
  {"id":"choice-000013","nodeId":"dk3o5u4e","sourceIndex":0,"legacy":{"text":"「手艺真好。是你做的吗？」","target":"c1q4a","cond":"","set":"好感 += 5"}},
  {"id":"choice-000014","nodeId":"dk3o5u4e","sourceIndex":1,"legacy":{"text":"「谢谢，很好吃。」","target":"c1q4b","cond":"","set":"好感 += 3"}},
  {"id":"choice-000015","nodeId":"dk3o5u4e","sourceIndex":2,"legacy":{"text":"（默默吃掉）","target":"c1q4c","cond":"","set":"好感 -= 1"}},
  {"id":"choice-000016","nodeId":"cvelvwin","sourceIndex":0,"legacy":{"text":"「那风化程度如何？」","target":"c2q1a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000017","nodeId":"cvelvwin","sourceIndex":1,"legacy":{"text":"「想我了吗？」","target":"c2q1b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000018","nodeId":"cvelvwin","sourceIndex":2,"legacy":{"text":"把酸梅汤直接递过去。","target":"c2q1c","cond":"","set":"好感 += 1"}},
  {"id":"choice-000019","nodeId":"pkayznot","sourceIndex":0,"legacy":{"text":"「要是别人也喊桂花呢？」","target":"c2q2a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000020","nodeId":"pkayznot","sourceIndex":1,"legacy":{"text":"「为什么是暗号，不能直接说吗？」","target":"c2q2b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000021","nodeId":"pkayznot","sourceIndex":2,"legacy":{"text":"「成交。那第二个暗号是什么？」","target":"c2q2c","cond":"","set":"好感 += 3"}},
  {"id":"choice-000022","nodeId":"kg8xkzda","sourceIndex":0,"legacy":{"text":"签字，并在落款后加一行小字。","target":"c2q3a","cond":"","set":"好感 += 10"}},
  {"id":"choice-000023","nodeId":"kg8xkzda","sourceIndex":1,"legacy":{"text":"讨价还价：「那我的权利呢？」","target":"c2q3b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000024","nodeId":"kg8xkzda","sourceIndex":2,"legacy":{"text":"「这算卖身契吗？」","target":"c2q3c","cond":"","set":"好感 -= 3"}},
  {"id":"choice-000025","nodeId":"a7c5njix","sourceIndex":0,"legacy":{"text":"「那就把重要的事都写进暗号里。」","target":"c2q4a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000026","nodeId":"a7c5njix","sourceIndex":1,"legacy":{"text":"「记不住也没关系，我记得。」","target":"c2q4b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000027","nodeId":"a7c5njix","sourceIndex":2,"legacy":{"text":"「你记性明明很好。」","target":"c2q4c","cond":"","set":""}},
  {"id":"choice-000028","nodeId":"estubhxy","sourceIndex":0,"legacy":{"text":"「奥运选手水平。」","target":"c3q1a","cond":"","set":"好感 -= 2"}},
  {"id":"choice-000029","nodeId":"estubhxy","sourceIndex":1,"legacy":{"text":"「……能狗刨三十米。」","target":"c3q1b","cond":"","set":"好感 += 3"}},
  {"id":"choice-000030","nodeId":"estubhxy","sourceIndex":2,"legacy":{"text":"「不会。但是不怕。」","target":"c3q1c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000031","nodeId":"krsgixfj","sourceIndex":0,"legacy":{"text":"「这就是……你要带我看的地方？」","target":"c3q2a","cond":"","set":"好感 += 5"}},
  {"id":"choice-000032","nodeId":"krsgixfj","sourceIndex":1,"legacy":{"text":"「你来过这里很多次了？」","target":"c3q2b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000033","nodeId":"krsgixfj","sourceIndex":2,"legacy":{"text":"松开手，去碰最近的一株发光珊瑚。","target":"c3q2c","cond":"","set":""}},
  {"id":"choice-000034","nodeId":"raw1hwhm","sourceIndex":0,"legacy":{"text":"「对不起。」","target":"c3q2c1","cond":"","set":"好感 -= 5"}},
  {"id":"choice-000035","nodeId":"raw1hwhm","sourceIndex":1,"legacy":{"text":"「你刚才也吓到了吧。」","target":"c3q2c2","cond":"","set":"好感 += 6"}},
  {"id":"choice-000036","nodeId":"3pazn66p","sourceIndex":0,"legacy":{"text":"「我记住了。」","target":"c3q3a","cond":"","set":"好感 += 5"}},
  {"id":"choice-000037","nodeId":"3pazn66p","sourceIndex":1,"legacy":{"text":"「是谁教你这句话的？」","target":"c3q3b","cond":"","set":"好感 += 3"}},
  {"id":"choice-000038","nodeId":"3pazn66p","sourceIndex":2,"legacy":{"text":"伸手，替她拨开挡在眼前的头发。","target":"c3q3c","cond":"","set":"好感 += 12"}},
  {"id":"choice-000039","nodeId":"ztbspbz6","sourceIndex":0,"legacy":{"text":"「嗯，我妻子。」","target":"c4q1a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000040","nodeId":"ztbspbz6","sourceIndex":1,"legacy":{"text":"「呃，我们是一起来的。」","target":"c4q1b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000041","nodeId":"ztbspbz6","sourceIndex":2,"legacy":{"text":"「严格来说，我是她雇的。」","target":"c4q1c","cond":"","set":"好感 += 4"}},
  {"id":"choice-000042","nodeId":"7rlvll7t","sourceIndex":0,"legacy":{"text":"「因为你没有否认。」","target":"c4q2a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000043","nodeId":"7rlvll7t","sourceIndex":1,"legacy":{"text":"「因为奶奶会送手链。」","target":"c4q2b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000044","nodeId":"7rlvll7t","sourceIndex":2,"legacy":{"text":"「需要理由吗？」","target":"c4q2c","cond":"","set":"好感 += 2"}},
  {"id":"choice-000045","nodeId":"328r2a4x","sourceIndex":0,"legacy":{"text":"「那你来写。」","target":"c5q1a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000046","nodeId":"328r2a4x","sourceIndex":1,"legacy":{"text":"「这叫大巧不工。」","target":"c5q1b","cond":"","set":"好感 += 1"}},
  {"id":"choice-000047","nodeId":"328r2a4x","sourceIndex":2,"legacy":{"text":"「起码比你尾巴拍水有节奏。」","target":"c5q1c","cond":"","set":"好感 -= 2"}},
  {"id":"choice-000048","nodeId":"pm8x8v2h","sourceIndex":0,"legacy":{"text":"「这首诗……每句的第一个字。」","target":"c5q2a","cond":"","set":"好感 += 15"}},
  {"id":"choice-000049","nodeId":"pm8x8v2h","sourceIndex":1,"legacy":{"text":"「写得真好。教我。」","target":"c5q2b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000050","nodeId":"pm8x8v2h","sourceIndex":2,"legacy":{"text":"（沉默）","target":"c5q2c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000051","nodeId":"750wy8c2","sourceIndex":0,"legacy":{"text":"一口气说完。","target":"c6q1a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000052","nodeId":"750wy8c2","sourceIndex":1,"legacy":{"text":"「你确定要听吗？」","target":"c6q1b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000053","nodeId":"750wy8c2","sourceIndex":2,"legacy":{"text":"从十五天的第一天讲起。","target":"c6q1c","cond":"","set":"好感 += 5"}},
  {"id":"choice-000054","nodeId":"pd6lvptm","sourceIndex":0,"legacy":{"text":"「你记得答案的形状。」","target":"c6q2a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000055","nodeId":"pd6lvptm","sourceIndex":1,"legacy":{"text":"「记忆不是唯一的凭证。」","target":"c6q2b","cond":"","set":"好感 += 15"}},
  {"id":"choice-000056","nodeId":"pd6lvptm","sourceIndex":2,"legacy":{"text":"「你觉得算，就算。」","target":"c6q2c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000057","nodeId":"duaibm68","sourceIndex":0,"legacy":{"text":"「给你讲个捡贝壳的人的故事。」","target":"c7q1a","cond":"","set":"好感 += 4"}},
  {"id":"choice-000058","nodeId":"duaibm68","sourceIndex":1,"legacy":{"text":"「这块送你。」","target":"c7q1b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000059","nodeId":"duaibm68","sourceIndex":2,"legacy":{"text":"「你说，捡贝壳的人最后会怎么样？」","target":"c7q1a","cond":"","set":"好感 += 4"}},
  {"id":"choice-000060","nodeId":"7djw7u21","sourceIndex":0,"legacy":{"text":"《冒险家和海豚》","target":"c7q2a","cond":"","set":""}},
  {"id":"choice-000061","nodeId":"7djw7u21","sourceIndex":1,"legacy":{"text":"《贝壳姑娘》","target":"c7q2b","cond":"","set":"贝壳延后 = 1"}},
  {"id":"choice-000062","nodeId":"gddlochb","sourceIndex":0,"legacy":{"text":"「海豚说：我们还要去救下一个人。」","target":"c7q3a","cond":"","set":"好感 += 6"}},
  {"id":"choice-000063","nodeId":"gddlochb","sourceIndex":1,"legacy":{"text":"「海豚说：你已经回报过了。」","target":"c7q3b","cond":"","set":"好感 += 10"}},
  {"id":"choice-000064","nodeId":"gddlochb","sourceIndex":2,"legacy":{"text":"「你猜。」","target":"c7q3c","cond":"","set":"好感 += 1"}},
  {"id":"choice-000065","nodeId":"ipdjcsw2","sourceIndex":0,"legacy":{"text":"「故事里的海豚不是挺仗义的嘛。」","target":"c7q4a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000066","nodeId":"ipdjcsw2","sourceIndex":1,"legacy":{"text":"「海豚哪有你可靠。」","target":"c7q4b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000067","nodeId":"ipdjcsw2","sourceIndex":2,"legacy":{"text":"（举起手挡住视线）「报告验收官，没看。」","target":"c7q4c","cond":"","set":"好感 += 5"}},
  {"id":"choice-000068","nodeId":"crc09jyg","sourceIndex":0,"legacy":{"text":"「我啊，是个笨蛋。第一次就捡到了美丽的贝壳。」","target":"c7q5a","cond":"","set":"好感 += 15"}},
  {"id":"choice-000069","nodeId":"crc09jyg","sourceIndex":1,"legacy":{"text":"「如果我说『是』呢？」","target":"c7q5b","cond":"","set":"好感 -= 8"}},
  {"id":"choice-000070","nodeId":"crc09jyg","sourceIndex":2,"legacy":{"text":"（沉默，继续走）","target":"c7q5c","cond":"","set":""}},
  {"id":"choice-000071","nodeId":"jrutikwi","sourceIndex":0,"legacy":{"text":"「我啊，是个笨蛋。第一次就捡到了美丽的贝壳。」","target":"c7q5a","cond":"","set":"好感 += 15"}},
  {"id":"choice-000072","nodeId":"tolq52wt","sourceIndex":0,"legacy":{"text":"「好好好，光明正大。」","target":"c7q6a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000073","nodeId":"tolq52wt","sourceIndex":1,"legacy":{"text":"「那要是贝壳姑娘另有其人呢？」","target":"c7q6b","cond":"","set":"好感 += 8"}},
  {"id":"choice-000074","nodeId":"tolq52wt","sourceIndex":2,"legacy":{"text":"「明天开始，每天给你准备零食甜点。」","target":"c7q6c","cond":"","set":"好感 += 6"}},
  {"id":"choice-000075","nodeId":"h5ghodhs","sourceIndex":0,"legacy":{"text":"「带回去养吧。」","target":"c7q7a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000076","nodeId":"h5ghodhs","sourceIndex":1,"legacy":{"text":"「送回深水区？」","target":"c7q7b","cond":"","set":"好感 += 4; 海星放生 = 1"}},
  {"id":"choice-000077","nodeId":"fmj51dq7","sourceIndex":0,"legacy":{"text":"「荣幸。」","target":"c7q8a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000078","nodeId":"fmj51dq7","sourceIndex":1,"legacy":{"text":"「寻宝搭档的第一条规定是什么？」","target":"c7q8b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000079","nodeId":"fmj51dq7","sourceIndex":2,"legacy":{"text":"「能加薪吗？」","target":"c7q8c","cond":"","set":"好感 += 5"}},
  {"id":"choice-000080","nodeId":"3nnvr3w2","sourceIndex":0,"legacy":{"text":"「好。找一颗天青色的。」","target":"c7q9a","cond":"","set":"好感 += 10"}},
  {"id":"choice-000081","nodeId":"3nnvr3w2","sourceIndex":1,"legacy":{"text":"「珍珠有什么好的，贝壳才——」","target":"c7q9b","cond":"","set":"好感 += 2"}},
  {"id":"choice-000082","nodeId":"3nnvr3w2","sourceIndex":2,"legacy":{"text":"（沉默）","target":"c7q9c","cond":"","set":"好感 += 6"}},
  {"id":"choice-000083","nodeId":"hnjtr70q","sourceIndex":0,"legacy":{"text":"「长期的那种。」","target":"c8q1a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000084","nodeId":"hnjtr70q","sourceIndex":1,"legacy":{"text":"「房租我付得起。」","target":"c8q1b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000085","nodeId":"hnjtr70q","sourceIndex":2,"legacy":{"text":"「你的藤箱太小，帐篷装不下。」","target":"c8q1c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000086","nodeId":"hr7kt0q9","sourceIndex":0,"legacy":{"text":"「听老板娘的。」","target":"c8q2a","cond":"","set":"好感 += 10"}},
  {"id":"choice-000087","nodeId":"hr7kt0q9","sourceIndex":1,"legacy":{"text":"「《撒娇记》其实也挺——」","target":"c8q2b","cond":"","set":"好感 += 3"}},
  {"id":"choice-000088","nodeId":"hr7kt0q9","sourceIndex":2,"legacy":{"text":"「那书名页你题字。」","target":"c8q2c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000089","nodeId":"ucc6nise","sourceIndex":0,"legacy":{"text":"「那遇到鲸鱼小姐的那个人，该怎么写？」","target":"c8q3a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000090","nodeId":"ucc6nise","sourceIndex":1,"legacy":{"text":"「先吃饭，设定明天再聊。」","target":"c8q3b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000091","nodeId":"ucc6nise","sourceIndex":2,"legacy":{"text":"「稿费真不准拿？」","target":"c8q3c","cond":"","set":"好感 += 6"}},
  {"id":"choice-000092","nodeId":"zpdqlvme","sourceIndex":0,"legacy":{"text":"「……我只是开个玩笑。」","target":"c9q1a","cond":"","set":"好感 -= 10"}},
  {"id":"choice-000093","nodeId":"zpdqlvme","sourceIndex":1,"legacy":{"text":"「你误会了，不是你想的那样。」","target":"c9q1b","cond":"","set":"好感 -= 10"}},
  {"id":"choice-000094","nodeId":"zpdqlvme","sourceIndex":2,"legacy":{"text":"（沉默）","target":"c9q1c","cond":"","set":"好感 -= 15"}},
  {"id":"choice-000095","nodeId":"t1t93nt0","sourceIndex":0,"legacy":{"text":"「对不起。」","target":"c9q2a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000096","nodeId":"t1t93nt0","sourceIndex":1,"legacy":{"text":"伸手去拉她的手腕。","target":"c9q2b","cond":"","set":""}},
  {"id":"choice-000097","nodeId":"bb5ki6uy","sourceIndex":0,"legacy":{"text":"「全部答应。」","target":"c11q1a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000098","nodeId":"bb5ki6uy","sourceIndex":1,"legacy":{"text":"「我加一条。」","target":"c11q1b","cond":"","set":"好感 += 12"}},
  {"id":"choice-000099","nodeId":"bb5ki6uy","sourceIndex":2,"legacy":{"text":"（沉默）","target":"c11q1c","cond":"","set":"好感 += 10"}},
  {"id":"choice-000100","nodeId":"igdomjcq","sourceIndex":0,"legacy":{"text":"「那分成呢？」","target":"c12q1a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000101","nodeId":"igdomjcq","sourceIndex":1,"legacy":{"text":"「技术顾问同志，辛苦了。」","target":"c12q1b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000102","nodeId":"igdomjcq","sourceIndex":2,"legacy":{"text":"「条件太多，容我考虑——」","target":"c12q1c","cond":"","set":"好感 += 2"}},
  {"id":"choice-000103","nodeId":"f4fmjs1u","sourceIndex":0,"legacy":{"text":"「深海潮汐·布丁屋。」","target":"c12q2a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000104","nodeId":"f4fmjs1u","sourceIndex":1,"legacy":{"text":"「鲸鱼小姐的甜品站。」","target":"c12q2b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000105","nodeId":"f4fmjs1u","sourceIndex":2,"legacy":{"text":"「翡翠之梦。」","target":"c12q2c","cond":"","set":"好感 += 10"}},
  {"id":"choice-000106","nodeId":"wovhcmot","sourceIndex":0,"legacy":{"text":"「一半一半。」","target":"c13q1a","cond":"","set":"好感 += 8"}},
  {"id":"choice-000107","nodeId":"wovhcmot","sourceIndex":1,"legacy":{"text":"「主要是为了店里。」","target":"c13q1b","cond":"","set":"好感 += 2"}},
  {"id":"choice-000108","nodeId":"wovhcmot","sourceIndex":2,"legacy":{"text":"「主要是为了写稿。」","target":"c13q1c","cond":"","set":"好感 += 1"}},
  {"id":"choice-000109","nodeId":"31cfmza3","sourceIndex":0,"legacy":{"text":"「这颗多少钱？」","target":"c13q2a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000110","nodeId":"31cfmza3","sourceIndex":1,"legacy":{"text":"「老板，这碟都要了。」","target":"c13q2b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000111","nodeId":"31cfmza3","sourceIndex":2,"legacy":{"text":"指着她：「她自己挑。」","target":"c13q2c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000112","nodeId":"0idms3yx","sourceIndex":0,"legacy":{"text":"「家里不是有一颗吗？」","target":"c13q3a","cond":"","set":"好感 += 6"}},
  {"id":"choice-000113","nodeId":"0idms3yx","sourceIndex":1,"legacy":{"text":"「好，去选。」","target":"c13q3b","cond":"","set":"好感 += 8"}},
  {"id":"choice-000114","nodeId":"0idms3yx","sourceIndex":2,"legacy":{"text":"「珍珠为什么要成对？」","target":"c13q3c","cond":"","set":"好感 += 5"}},
  {"id":"choice-000115","nodeId":"p4scg2o0","sourceIndex":0,"legacy":{"text":"「我那颗，也刻『验』吧。一对。」","target":"c13q4a","cond":"","set":"好感 += 15"}},
  {"id":"choice-000116","nodeId":"p4scg2o0","sourceIndex":1,"legacy":{"text":"「刻日期。」","target":"c13q4b","cond":"","set":"好感 += 10"}},
  {"id":"choice-000117","nodeId":"p4scg2o0","sourceIndex":2,"legacy":{"text":"「听她的。」","target":"c13q4c","cond":"","set":"好感 += 6"}},
  {"id":"choice-000118","nodeId":"68du9pmx","sourceIndex":0,"legacy":{"text":"「好。肩膀。」（老老实实）","target":"c13q5a","cond":"","set":"好感 += 6"}},
  {"id":"choice-000119","nodeId":"68du9pmx","sourceIndex":1,"legacy":{"text":"「耳朵红成这样，是屋里太热吗？」","target":"c13q5b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000120","nodeId":"68du9pmx","sourceIndex":2,"legacy":{"text":"（笑而不语，继续按肩）","target":"c13q5c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000121","nodeId":"f373b3kz","sourceIndex":0,"legacy":{"text":"把清单列出来。","target":"c14q1a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000122","nodeId":"f373b3kz","sourceIndex":1,"legacy":{"text":"只说「你最近总记错小事」。","target":"c14q1b","cond":"","set":""}},
  {"id":"choice-000123","nodeId":"f373b3kz","sourceIndex":2,"legacy":{"text":"（先摸摸头再说）","target":"c14q1c","cond":"","set":"好感 += 5"}},
  {"id":"choice-000124","nodeId":"89gkr73f","sourceIndex":0,"legacy":{"text":"列清单。","target":"c14q1a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000125","nodeId":"89gkr73f","sourceIndex":1,"legacy":{"text":"「……算了，当我没说。」","target":"c14q1b2","cond":"","set":"好感 -= 5"}},
  {"id":"choice-000126","nodeId":"f507fb7z","sourceIndex":0,"legacy":{"text":"「别生气，是我的错。不过……你真的打算不要带鱼了吗？」","target":"c14q2a","cond":"","set":"好感 += 10"}},
  {"id":"choice-000127","nodeId":"f507fb7z","sourceIndex":1,"legacy":{"text":"「可房贷真的是个玩笑啊。」","target":"c14q2b","cond":"","set":"好感 -= 20; 玩笑 = 1"}},
  {"id":"choice-000128","nodeId":"f507fb7z","sourceIndex":2,"legacy":{"text":"（买一串烤鱿鱼，追上去塞进她手里）","target":"c14q2c","cond":"","set":"好感 += 12"}},
  {"id":"choice-000129","nodeId":"1794nozx","sourceIndex":0,"legacy":{"text":"「成交。」","target":"c14q3a","cond":"","set":"好感 += 5"}},
  {"id":"choice-000130","nodeId":"1794nozx","sourceIndex":1,"legacy":{"text":"「那你也得写。」","target":"c14q3b","cond":"","set":"好感 += 8"}},
  {"id":"choice-000131","nodeId":"1794nozx","sourceIndex":2,"legacy":{"text":"「批注有字数限制吗？」","target":"c14q3c","cond":"","set":"好感 += 4"}},
  {"id":"choice-000132","nodeId":"p0aq7vhx","sourceIndex":0,"legacy":{"text":"「那是怕你不够吃。」","target":"c15q1a","cond":"","set":"好感 += 1"}},
  {"id":"choice-000133","nodeId":"p0aq7vhx","sourceIndex":1,"legacy":{"text":"「……我错了。」","target":"c15q1b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000134","nodeId":"p0aq7vhx","sourceIndex":2,"legacy":{"text":"「下周菜单里有不加海藻的版本吗？」","target":"c15q1c","cond":"","set":"好感 += 1"}},
  {"id":"choice-000135","nodeId":"wfqigi6f","sourceIndex":0,"legacy":{"text":"「请老板娘开条件。」","target":"c15q2a","cond":"","set":"好感 += 3"}},
  {"id":"choice-000136","nodeId":"wfqigi6f","sourceIndex":1,"legacy":{"text":"「驳回不就是终审吗？」","target":"c15q2b","cond":"","set":"好感 += 3"}},
  {"id":"choice-000137","nodeId":"wfqigi6f","sourceIndex":2,"legacy":{"text":"（沉默）","target":"c15q2c","cond":"","set":"好感 += 5"}},
  {"id":"choice-000138","nodeId":"m3j2zl6r","sourceIndex":0,"legacy":{"text":"「听懂了。一周，从现在算起。」","target":"c15q3a","cond":"","set":"好感 += 6"}},
  {"id":"choice-000139","nodeId":"m3j2zl6r","sourceIndex":1,"legacy":{"text":"「那要是你做不到呢？」","target":"c15q3b","cond":"","set":"好感 += 3"}},
  {"id":"choice-000140","nodeId":"m3j2zl6r","sourceIndex":2,"legacy":{"text":"「可以拉钩吗？」","target":"c15q3c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000141","nodeId":"i1frlnhd","sourceIndex":0,"legacy":{"text":"把她的日记改成对的。","target":"c15q4a","cond":"","set":"好感 -= 5"}},
  {"id":"choice-000142","nodeId":"i1frlnhd","sourceIndex":1,"legacy":{"text":"「不用改。两本都留着。」","target":"c15q4b","cond":"","set":"好感 += 12"}},
  {"id":"choice-000143","nodeId":"i1frlnhd","sourceIndex":2,"legacy":{"text":"「好，是店里厨房。」","target":"c15q4c","cond":"","set":"好感 += 15"}},
  {"id":"choice-000144","nodeId":"z2cd08ag","sourceIndex":0,"legacy":{"text":"「等等。你说的『考虑一下』，还没答复。」","target":"c15q5a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000145","nodeId":"z2cd08ag","sourceIndex":1,"legacy":{"text":"「刚才那个，算早安吻吗？」","target":"c15q5b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000146","nodeId":"z2cd08ag","sourceIndex":2,"legacy":{"text":"拉住她的手腕。","target":"c15q5c","cond":"","set":"好感 += 10"}},
  {"id":"choice-000147","nodeId":"06hq9k23","sourceIndex":0,"legacy":{"text":"「确实写不出来。」","target":"c15q6a","cond":"","set":"好感 += 5"}},
  {"id":"choice-000148","nodeId":"06hq9k23","sourceIndex":1,"legacy":{"text":"「写不出来。而且被拒绝，很难受。」","target":"c15q6b","cond":"","set":"好感 += 15"}},
  {"id":"choice-000149","nodeId":"06hq9k23","sourceIndex":2,"legacy":{"text":"「没什么，我这就去写。」","target":"c15q6c","cond":"","set":"好感 += 2"}},
  {"id":"choice-000150","nodeId":"fdp1qtcz","sourceIndex":0,"legacy":{"text":"「你想要什么样的？」","target":"c16q1a","cond":"","set":"好感 += 15"}},
  {"id":"choice-000151","nodeId":"fdp1qtcz","sourceIndex":1,"legacy":{"text":"「公主和王子的童话。」","target":"c16q1b","cond":"","set":"好感 += 5"}},
  {"id":"choice-000152","nodeId":"fdp1qtcz","sourceIndex":2,"legacy":{"text":"「我都行，你验收。」","target":"c16q1c","cond":"","set":"好感 += 3"}},
  {"id":"choice-000153","nodeId":"7edgihqs","sourceIndex":0,"legacy":{"text":"「我先看完再烧。」","target":"x1q1a","cond":"","set":"好感 += 5"}},
  {"id":"choice-000154","nodeId":"7edgihqs","sourceIndex":1,"legacy":{"text":"「这上面写的，是真的吗？」","target":"x1q1b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000155","nodeId":"7edgihqs","sourceIndex":2,"legacy":{"text":"（把纸举高）","target":"x1q1c","cond":"","set":"好感 += 4"}},
  {"id":"choice-000156","nodeId":"3wd0u0ld","sourceIndex":0,"legacy":{"text":"「很合身。」","target":"x1q2a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000157","nodeId":"3wd0u0ld","sourceIndex":1,"legacy":{"text":"「袜子滑下来了。」","target":"x1q2b","cond":"","set":"好感 += 4"}},
  {"id":"choice-000158","nodeId":"3wd0u0ld","sourceIndex":2,"legacy":{"text":"（默默把视线固定在她眼睛的高度）","target":"x1q2c","cond":"","set":"好感 += 8"}},
  {"id":"choice-000159","nodeId":"0zskri5m","sourceIndex":0,"legacy":{"text":"「怪我什么？」","target":"x1q3a","cond":"","set":"好感 += 6"}},
  {"id":"choice-000160","nodeId":"0zskri5m","sourceIndex":1,"legacy":{"text":"「那我们现在回家换衣服？」","target":"x1q3b","cond":"","set":"好感 += 8"}},
  {"id":"choice-000161","nodeId":"0zskri5m","sourceIndex":2,"legacy":{"text":"「珍珠还买吗？」","target":"x1q3c","cond":"","set":"好感 += 10"}},
  {"id":"choice-000162","nodeId":"xy8pqg3v","sourceIndex":0,"legacy":{"text":"「低头。我帮你戴。」","target":"x2q1a","cond":"","set":"好感 += 10"}},
  {"id":"choice-000163","nodeId":"xy8pqg3v","sourceIndex":1,"legacy":{"text":"「绳子是素了点，下次配银链。」","target":"x2q1b","cond":"","set":"好感 += 6"}},
  {"id":"choice-000164","nodeId":"xy8pqg3v","sourceIndex":2,"legacy":{"text":"「不要我就收回。」","target":"x2q1c","cond":"","set":"好感 += 4"}},
  {"id":"choice-000165","nodeId":"a1a1pmn3","sourceIndex":0,"legacy":{"text":"「那就重新戴上，试试效果。」","target":"x2q2a","cond":"","set":"好感 += 12"}},
  {"id":"choice-000166","nodeId":"a1a1pmn3","sourceIndex":1,"legacy":{"text":"「那算了，睡觉。」","target":"x2q2b","cond":"","set":"好感 += 8"}},
  {"id":"choice-000167","nodeId":"a1a1pmn3","sourceIndex":2,"legacy":{"text":"「一百条太多了，十串行不行。」","target":"x2q2c","cond":"","set":"好感 += 2"}}
]
