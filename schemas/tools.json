{
  "$comment": "Agent 工具注册表（PLAN §11.1）。同一份定义生成模型的 function calling 列表与外部 Agent 端口（预留）。effect: read 读 / perform 演出 / propose 提议 / memory 记忆 / reserved 预留。所有改状态的效果都由引擎裁决。",
  "version": 1,
  "tools": [
    {"name": "say", "effect": "perform", "description": "说一句台词（一次一句，≤60 字）。台词以外的自由文本不会上屏。动作用中文括号写在句子里。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["text"],
       "properties": {"text": {"type": "string", "maxLength": 80}}}},
    {"name": "honesty_signal", "effect": "perform", "description": "诚实信号：身体出卖真心（如尾鳍卷圈）。signal_id 只能取角色卡里的信号；本章 AI 至多 1 次，多了会被驳回。noticed=true 表示她发现自己被出卖、慌忙压住。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["signal_id", "action"],
       "properties": {"signal_id": {"type": "string"}, "action": {"type": "string", "description": "这次具体的动作描写"}, "noticed": {"type": "boolean"}}}},
    {"name": "set_sprite", "effect": "perform", "description": "换立绘差分，expr 取卡里的差分清单。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["expr"],
       "properties": {"expr": {"type": "string"}}}},
    {"name": "play_sfx", "effect": "perform", "description": "音效（占位）。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["id"],
       "properties": {"id": {"type": "string"}}}},
    {"name": "propose_affection", "effect": "propose", "description": "提议好感变化。surface=嘴上表现，inner=心里真实（不显示）。引擎按单步 ±5、本次插曲净额 ±3、章节预算裁剪。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["surface", "reason"],
       "properties": {"surface": {"type": "integer", "minimum": -5, "maximum": 5}, "inner": {"type": "integer", "minimum": -5, "maximum": 5}, "reason": {"type": "string"}}}},
    {"name": "propose_mood", "effect": "propose", "description": "提议心情变化（-2..2）。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["delta"],
       "properties": {"delta": {"type": "integer", "minimum": -2, "maximum": 2}, "reason": {"type": "string"}}}},
    {"name": "write_memory", "effect": "memory", "description": "把一件值得记住的事写进她的笔记（原文、一句话）。这只是她的笔记，不会变成事实；玩家的说法照实记成“玩家说……”。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["content"],
       "properties": {"content": {"type": "string", "maxLength": 120}}}},
    {"name": "propose_branch", "effect": "propose", "description": "提议开新分支（Demo 只记录，不演出）。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["summary"],
       "properties": {"summary": {"type": "string"}}}},
    {"name": "request_ending", "effect": "propose", "description": "请求结局（只有导演能宣布结局，模型的请求一律驳回并记录）。",
     "parameters": {"type": "object", "additionalProperties": false, "required": ["summary"],
       "properties": {"summary": {"type": "string"}}}},
    {"name": "generate_image", "effect": "reserved", "description": "生图（接口预留，Demo 未启用）。",
     "parameters": {"type": "object", "properties": {"prompt": {"type": "string"}}}},
    {"name": "speak", "effect": "reserved", "description": "语音（接口预留，Demo 未启用）。",
     "parameters": {"type": "object", "properties": {"text": {"type": "string"}, "voice": {"type": "string"}}}},
    {"name": "propose_music_mood", "effect": "reserved", "description": "提议配乐情绪（接口预留）。",
     "parameters": {"type": "object", "properties": {"mood": {"type": "string"}}}}
  ]
}
